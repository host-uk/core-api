{
    "name": "host-uk/core-api",
    "description": "REST API module for Core PHP framework",
    "keywords": ["laravel", "api", "rest", "json"],
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.2",
        "host-uk/core": "@dev",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^5.26|^6.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/host-uk/core-php",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\Api\\": "src/Api/",
            "Core\\Website\\Api\\": "src/Website/Api/"
        }
    },
    "extra": {
        "laravel": {
            "providers": []
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
